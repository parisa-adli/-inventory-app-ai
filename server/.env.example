# Server Configuration
PORT=5000

# Database
MONGODB_URI=mongodb://localhost:27017/inventory

# JWT Secrets (generate secure random strings for production)
JWT_ACCESS_SECRET=your-access-secret-here-change-in-production
JWT_REFRESH_SECRET=your-refresh-secret-here-change-in-production

# Cookie Configuration
COOKIE_DOMAIN=localhost

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# Telegram Bot
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-from-botfather
TELEGRAM_MODE=polling

# Email Service (Brevo SMTP)
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=your-brevo-smtp-user
BREVO_SMTP_PASS=your-brevo-smtp-password

# Application URL (for email verification/reset links)
APP_URL=http://localhost:5000

# Runtime
NODE_ENV=development

# Token lifetimes (jsonwebtoken / ms style: 15m, 7d)
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
