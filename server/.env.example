# Server Configuration
PORT=5000

# Database
MONGODB_URI=mongodb://localhost:27017/inventory

# JWT Secrets (generate secure random strings for production)
JWT_ACCESS_SECRET=your-access-secret-here-change-in-production
JWT_REFRESH_SECRET=your-refresh-secret-here-change-in-production

# Cookie Configuration
COOKIE_DOMAIN=localhost

# Client URL (CORS origin, and the base of emailed verify/reset links)
CLIENT_URL=http://localhost:5173

# Telegram Bot
# Without a real token the bot does not start, so a QR login cannot be approved from Telegram (dev only).
# TELEGRAM_BOT_USERNAME builds the t.me deep link inside the sign in QR code.
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-from-botfather
TELEGRAM_BOT_USERNAME=your_bot_username
# polling (default, used in production) or webhook
TELEGRAM_MODE=polling
# Webhook mode only: the public HTTPS origin of this server and the secret_token Telegram echoes back
TELEGRAM_WEBHOOK_SECRET=your-webhook-secret
# PUBLIC_URL=https://api.example.com

# Email Service (Brevo SMTP)
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=your-brevo-smtp-user
BREVO_SMTP_PASS=your-brevo-smtp-password

# Sender shown on outgoing mail (must be a verified Brevo sender in production)
EMAIL_FROM=Inventory Manager <no-reply@example.com>

# Runtime
NODE_ENV=development

# Token lifetimes (jsonwebtoken / ms style: 15m, 7d)
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
